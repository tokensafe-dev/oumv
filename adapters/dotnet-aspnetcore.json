{
  "identity": {
    "id": "backend/aspnetcore",
    "name": "TokenSafe OUMV adapter for ASP.NET Core",
    "version": "0.4.0",
    "description": "OUMV adapter for ASP.NET Core (minimal APIs + MVC, EF Core rollback sandbox)",
    "repo": "https://github.com/tokensafe-dev/tokensafe-backend"
  },
  "technology": {
    "language": "csharp",
    "framework": "aspnetcore",
    "minFrameworkVersion": "net8.0",
    "package": {
      "manager": "nuget",
      "name": "TokenSafe.Oumv.AspNetCore",
      "install": "dotnet add package TokenSafe.Oumv.AspNetCore"
    }
  },
  "profiles": [
    "backend"
  ],
  "modes": [
    "read-write",
    "read-only"
  ],
  "capabilities": [
    {
      "name": "observe.pulse",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.surface",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.contract",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.traces",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "understand.impact",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "understand.causality",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "mutate.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ],
        "limitations": [
          "OCC expectedVersion is mandatory; stale tokens fail with -32001"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "verify.behavior",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "mutate.multiFile",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file"
        ],
        "limitations": [
          "each item is validated and syntax-checked before the first write; a write failure restores what was written"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "sessions.ttlSeconds",
      "constraints": {
        "developmentOnly": false,
        "resourceTypes": [],
        "limitations": [
          "requested lifetime is clamped to 1..86400 and echoed as the granted ttlSeconds"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "verify.sandboxRollback",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "database"
        ],
        "limitations": [
          "EF Core transaction is rolled back per request; rolledBack/dbDiff evidence only from an observed rollback"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "mutate.preview",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file"
        ],
        "limitations": [
          "§4.4 dry-run: the full applyEdit guard chain (jail, existence, OCC, hunks, Roslyn pre-flight) runs without any write"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "sessions.cancel",
      "constraints": {
        "developmentOnly": false,
        "resourceTypes": [],
        "limitations": [
          "cooperative requestId cancellation; unknown or finished ids answer cancelled:false, never an error"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "index.symbols",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file",
          "symbol"
        ],
        "limitations": [
          "ranked exact > prefix > suffix > substring over source files"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "verify.build",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file"
        ],
        "limitations": [
          "runs OumvOptions.BuildCommand or params.command; no command keeps an honest skipped with a reason"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "observeQuery.readOnly",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "database"
        ],
        "limitations": [
          "one SELECT/EXPLAIN/PRAGMA/WITH/VALUES/SHOW/DESCRIBE per call over the discovered DbContext connection, inside a rolled-back transaction; writes answer -32003 query_forbidden"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "deployment.read_only",
      "constraints": {
        "readOnly": true,
        "limitations": [
          "read-only mode registers no applyEdit/previewEdit/verify/build: they answer -32601 METHOD_NOT_FOUND (spec §8.5)",
          "the handshake advertises capabilities.readOnly and omits mutate/verify"
        ]
      },
      "conformanceLevel": 1
    }
  ],
  "security": {
    "productionFailClosed": true,
    "workspaceBoundary": true
  }
}
