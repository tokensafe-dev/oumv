{
  "identity": {
    "id": "backend/stdhttp",
    "name": "TokenSafe OUMV adapter for net/http",
    "version": "0.4.3",
    "description": "OUMV adapter for net/http",
    "repo": "https://github.com/tokensafe-dev/tokensafe-backend"
  },
  "technology": {
    "language": "go",
    "framework": "net/http",
    "package": {
      "manager": "go",
      "name": "github.com/tokensafe-dev/tokensafe-backend/go",
      "install": "go get github.com/tokensafe-dev/tokensafe-backend/go@v0.9.0"
    }
  },
  "profiles": [
    "backend"
  ],
  "capabilities": [
    {
      "name": "observe.pulse",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.surface",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.contract",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.traces",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ],
        "limitations": []
      },
      "conformanceLevel": 3
    },
    {
      "name": "understand.impact",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "understand.causality",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "mutate.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ],
        "limitations": [
          "OCC expectedVersion is mandatory; stale tokens fail with -32001"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "verify.behavior",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "mutate.multiFile",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file"
        ],
        "limitations": [
          "each item is validated and syntax-checked before the first write; a write failure restores what was written"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "sessions.ttlSeconds",
      "constraints": {
        "developmentOnly": false,
        "limitations": [
          "requested lifetime is clamped to 1..86400 and echoed as the granted ttlSeconds"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "mutate.preview",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file"
        ],
        "limitations": [
          "§4.4 dry-run: the full applyEdit guard order (boundary, existence, syntax pre-flight, expectedVersion, OCC) runs without any write"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "sessions.cancel",
      "constraints": {
        "developmentOnly": false,
        "resourceTypes": [],
        "limitations": [
          "best-effort (§3): unknown request ids and finished requests answer as results, never errors"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "sessions.idempotency",
      "constraints": {
        "developmentOnly": false,
        "resourceTypes": [],
        "limitations": [
          "per-session first-result-wins replay: a retried mutation returns the original result instead of re-applying"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "index.symbols",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file",
          "symbol"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "verify.build",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file"
        ],
        "limitations": [
          "honest skip: status=skipped with skipReason when no build command is wired"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "verify.sandboxRollback",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "database"
        ],
        "limitations": [
          "one transaction per request; rolledBack/dbDiff evidence only from an observed rollback"
        ]
      },
      "conformanceLevel": 2
    }
  ],
  "security": {
    "productionFailClosed": true,
    "workspaceBoundary": true
  }
}
