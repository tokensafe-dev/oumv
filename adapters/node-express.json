{
  "identity": {
    "id": "backend/express",
    "name": "TokenSafe OUMV adapter for Express",
    "version": "0.1.0",
    "description": "OUMV adapter for Express (HTTP, SSE, WebSocket)",
    "repo": "https://github.com/tokensafe-dev/tokensafe-backend"
  },
  "technology": {
    "language": "typescript",
    "framework": "express",
    "package": {
      "manager": "npm",
      "name": "tokensafe-backend-node",
      "install": "npm install tokensafe-backend-node"
    }
  },
  "profiles": [
    "backend"
  ],
  "capabilities": [
    {
      "name": "observe.pulse",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.surface",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.contract",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.traces",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ],
        "limitations": [
          "traces come from oumv/verify dispatches and the optional tracingMiddleware"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "understand.impact",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "understand.causality",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "mutate.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ],
        "limitations": [
          "OCC expectedVersion is mandatory; stale tokens fail with -32001",
          "a backup is written under .tokensafe/backups/ inside the workspace"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "verify.behavior",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ],
        "limitations": [
          "verification dispatches over loopback HTTP against the live handler"
        ]
      },
      "conformanceLevel": 2
    }
  ],
  "security": {
    "productionFailClosed": true,
    "workspaceBoundary": true
  }
}
