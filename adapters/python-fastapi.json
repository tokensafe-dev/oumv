{
  "identity": {
    "id": "backend/fastapi",
    "name": "TokenSafe OUMV adapter for FastAPI",
    "version": "0.3.0",
    "description": "OUMV adapter for FastAPI/Starlette (HTTP, SSE, WebSocket, stdio)",
    "repo": "https://github.com/tokensafe-dev/tokensafe-backend"
  },
  "technology": {
    "language": "python",
    "framework": "fastapi",
    "package": {
      "manager": "pip",
      "name": "tokensafe-backend-python",
      "install": "pip install tokensafe-backend-python"
    }
  },
  "profiles": [
    "backend"
  ],
  "capabilities": [
    {
      "name": "observe.pulse",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.surface",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.contract",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.traces",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ],
        "limitations": []
      },
      "conformanceLevel": 3
    },
    {
      "name": "understand.impact",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "understand.causality",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "mutate.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ],
        "limitations": [
          "OCC expectedVersion is mandatory; stale tokens fail with -32001"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "verify.behavior",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "route",
          "file"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "mutate.multiFile",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file"
        ],
        "limitations": [
          "each item is validated and syntax-checked before the first write; a write failure restores what was written"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "sessions.ttlSeconds",
      "constraints": {
        "developmentOnly": false,
        "limitations": [
          "requested lifetime is clamped to 1..86400 and echoed as the granted ttlSeconds"
        ]
      },
      "conformanceLevel": 3
    }
  ],
  "security": {
    "productionFailClosed": true,
    "workspaceBoundary": true
  }
}
