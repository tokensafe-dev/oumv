{
  "identity": {
    "id": "frontend/vue",
    "name": "tokensafe-ui OUMV adapter for Vue 3 + Vite",
    "version": "0.1.37",
    "description": "OUMV frontend adapter served by the Vite dev server (HTTP, SSE, WebSocket, batch)",
    "repo": "https://github.com/tokensafe-dev/agent-dom"
  },
  "technology": {
    "language": "typescript",
    "framework": "vue",
    "minFrameworkVersion": "3.3.0",
    "package": {
      "manager": "npm",
      "name": "tokensafe-ui",
      "install": "npm install -D tokensafe-ui @tokensafe-ui/vite"
    }
  },
  "profiles": [
    "frontend"
  ],
  "modes": [
    "read-write",
    "read-only"
  ],
  "capabilities": [
    {
      "name": "observe.pulse",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "component",
          "route",
          "store"
        ],
        "limitations": []
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.surface",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "component",
          "route",
          "store"
        ],
        "limitations": []
      },
      "conformanceLevel": 1
    },
    {
      "name": "observe.contract",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "component"
        ],
        "limitations": [
          "component state comes from the app's registered store; a component that registers nothing exposes its state keys without values"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file",
          "component"
        ],
        "limitations": [
          "SFC symbols are resolved inside <script>/<script setup>; template-only expressions are not editable symbols"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "observe.traces",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "runtime-event"
        ],
        "limitations": [
          "requires an open browser tab streaming traces over the Vite HMR channel",
          "certified in a real headless-Chrome tab (agent-dom/certification/vue-vite-browser.json)"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "understand.impact",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "component"
        ],
        "limitations": []
      },
      "conformanceLevel": 2
    },
    {
      "name": "understand.causality",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "runtime-event"
        ],
        "limitations": [
          "reports observed=false and a note when no browser traces exist",
          "certified in a real headless-Chrome tab (agent-dom/certification/vue-vite-browser.json)"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "mutate.source",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "file"
        ],
        "limitations": [
          "expectedVersion is mandatory; stale tokens fail with -32001",
          "mode=patch rejects a non-unique target with -32011 and returns occurrence lines plus suggested scoped hunks"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "verify.behavior",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "component"
        ],
        "requiresPermission": "browser-dispatch",
        "limitations": [
          "synthetic browser dispatch requires a connected tab; offline runs report scope.notExecuted",
          "certified in a real headless-Chrome tab (agent-dom/certification/vue-vite-browser.json)"
        ]
      },
      "conformanceLevel": 2
    },
    {
      "name": "sessions.ttlSeconds",
      "constraints": {
        "developmentOnly": false,
        "limitations": [
          "requested lifetime is clamped to 1..86400 and echoed as the granted ttlSeconds"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "mutate.preview",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "component",
          "file"
        ],
        "limitations": [
          "§4.4 dry-run: the full applyEdit guard order runs without any write"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "sessions.cancel",
      "constraints": {
        "developmentOnly": false,
        "resourceTypes": [],
        "limitations": [
          "best-effort (§3): unknown request ids and finished requests answer as results, never errors"
        ]
      },
      "conformanceLevel": 1
    },
    {
      "name": "sessions.idempotency",
      "constraints": {
        "developmentOnly": false,
        "resourceTypes": [],
        "limitations": [
          "per-session first-result-wins replay: a retried mutation returns the original result"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "index.symbols",
      "constraints": {
        "developmentOnly": true,
        "resourceTypes": [
          "component",
          "route",
          "file"
        ],
        "limitations": [
          "served from the static discovery index (components + routes); a live tab may union mounted components"
        ]
      },
      "conformanceLevel": 3
    },
    {
      "name": "deployment.read_only",
      "constraints": {
        "readOnly": true,
        "limitations": [
          "read-only mode registers no applyEdit/previewEdit/verify/build: they answer -32601 METHOD_NOT_FOUND (spec §8.5)",
          "the handshake advertises capabilities.readOnly and omits mutate/verify"
        ]
      },
      "conformanceLevel": 1
    }
  ],
  "security": {
    "productionFailClosed": true,
    "workspaceBoundary": true
  }
}
