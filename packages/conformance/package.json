{
  "name": "@oumv/conformance",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "OUMV conformance runner and CLIs: oumv-certify (HTTP/WS/stdio) and oumv-lint-adapter",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@oumv/protocol": "workspace:*",
    "@oumv/schema": "workspace:*",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "bin": {
    "oumv-certify": "./dist/cli/certify.js",
    "oumv-lint-adapter": "./dist/cli/lint-adapter.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
