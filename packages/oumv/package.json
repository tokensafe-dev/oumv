{
  "name": "tokensafe-oumv",
  "version": "1.5.5",
  "license": "Apache-2.0",
  "description": "OUMV: The Universal Agent-Runtime Protocol (UARP) (Observe \u00b7 Understand \u00b7 Mutate \u00b7 Verify) reference implementation and conformance engine",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "require": "./dist/conformance.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tokensafe-dev/oumv.git",
    "directory": "packages/oumv"
  },
  "homepage": "https://github.com/tokensafe-dev/oumv#readme",
  "bugs": {
    "url": "https://github.com/tokensafe-dev/oumv/issues"
  },
  "keywords": [
    "oumv",
    "protocol",
    "agent-runtime",
    "uarp",
    "ai-agent",
    "tokensafe",
    "conformance",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@oumv/conformance": "workspace:*",
    "@oumv/protocol": "workspace:*",
    "@oumv/schema": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "bin": {
    "oumv-certify": "./dist/cli/certify.js",
    "oumv-lint-adapter": "./dist/cli/lint-adapter.js"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
