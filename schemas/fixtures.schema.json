{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/tokensafe-dev/oumv/schemas/fixtures.schema.json",
 "title": "OUMV conformance fixtures",
 "x-oumv-spec-version": "1.3.0",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "protocolVersion",
  "fixtureVersion",
  "levelDefinitions",
  "cases"
 ],
 "properties": {
  "protocolVersion": {
   "type": "string"
  },
  "fixtureVersion": {
   "type": "integer",
   "minimum": 1
  },
  "spec": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "levelDefinitions": {
   "type": "object",
   "required": [
    "1",
    "2",
    "3"
   ],
   "properties": {
    "1": {
     "type": "string"
    },
    "2": {
     "type": "string"
    },
    "3": {
     "type": "string"
    }
   }
  },
  "cases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "level",
     "method",
     "params"
    ],    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "level": {
      "enum": [
       1,
       2,
       3
      ]
     },
     "method": {
      "type": "string",
      "pattern": "^oumv/"
     },
     "params": {
      "type": "object"
     },
     "preconditions": {
      "type": "array",
      "items": {
       "enum": [
        "verify"
       ]
      }
     },
     "expectResultFields": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "expectError": {
      "type": "object",
      "required": [
       "code"
      ],
      "properties": {
       "code": {
        "type": "integer"
       },
       "reason": {
        "type": "string"
       }
      }
     },
     "expectLevelEquals": {
      "type": "string"
     },
     "expectSha256Field": {
      "type": "string"
     },
     "expectArrayField": {
      "type": "string"
     },
     "expectEvidence": {
      "type": "boolean"
     },
     "expectVersionMatchesContent": {
      "type": "string"
     },
     "expectSchema": {
      "type": "string"
     },
     "expectValues": {
      "type": "object",
      "description": "JSON-path -> expected value (dotted paths, e.g. data.hasMore)",
      "additionalProperties": true
     }
    }
   }
  },
  "pushCases": {
   "type": "array",
   "description": "Server-push cases (spec §2.3/§2.4). Run only when the certificate is produced for the case's transport: `--sse` (requests over HTTP, events over SSE) or `--ws`.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "level",
     "transport",
     "trigger",
     "expectEvents"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "level": {
      "enum": [
       1,
       2,
       3
      ]
     },
     "transport": {
      "enum": [
       "sse",
       "ws"
      ]
     },
     "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "method",
       "params"
      ],
      "properties": {
       "method": {
        "type": "string",
        "pattern": "^oumv/"
       },
       "params": {
        "type": "object"
       }
      }
     },
     "expectEvents": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "event"
       ],
       "properties": {
        "event": {
         "type": "string"
        },
        "data": {
         "type": "object",
         "description": "Keys that must match the event payload (params for WS notifications)."
        }
       }
      }
     },
     "replay": {
      "type": "object",
      "description": "SSE only: reconnect with Last-Event-ID captured before the trigger and expect the same events again.",
      "additionalProperties": false,
      "properties": {
       "expectEvents": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "event"
         ],
         "properties": {
          "event": {
           "type": "string"
          },
          "data": {
           "type": "object"
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
