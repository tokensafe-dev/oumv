{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/tokensafe-dev/oumv/schemas/fixtures.schema.json",
 "title": "OUMV conformance fixtures",
 "x-oumv-spec-version": "1.5.0",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "protocolVersion",
  "fixtureVersion",
  "levelDefinitions",
  "cases"
 ],
 "properties": {
  "protocolVersion": {
   "type": "string"
  },
  "fixtureVersion": {
   "type": "integer",
   "minimum": 1
  },
  "spec": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "levelDefinitions": {
   "type": "object",
   "required": [
    "1",
    "2",
    "3"
   ],
   "properties": {
    "1": {
     "type": "string"
    },
    "2": {
     "type": "string"
    },
    "3": {
     "type": "string"
    }
   }
  },
  "cases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "level",
     "method",
     "params"
    ],    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "level": {
      "enum": [
       1,
       2,
       3
      ]
     },
     "method": {
      "type": "string",
      "pattern": "^oumv/"
     },
     "params": {
      "type": "object"
     },
     "preconditions": {
      "type": "array",
      "items": {
       "enum": [
        "verify"
       ]
      }
     },
     "expectResultFields": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "expectError": {
      "type": "object",
      "required": [
       "code"
      ],
      "properties": {
       "code": {
        "type": "integer"
       },
       "reason": {
        "type": "string"
       },
       "data": {
        "type": "object",
        "description": "Exact key/value pairs the error payload must carry (e.g. reason, editIndex).",
        "additionalProperties": true
       }
      }
     },
     "expectLevelEquals": {
      "type": "string"
     },
     "expectSha256Field": {
      "type": "string"
     },
     "expectArrayField": {
      "type": "string"
     },
     "expectEvidence": {
      "type": "boolean"
     },
     "expectVersionMatchesContent": {
      "type": "string"
     },
     "expectSchema": {
      "type": "string"
     },
     "expectValues": {
      "type": "object",
      "description": "JSON-path -> expected value (dotted paths, e.g. data.hasMore)",
      "additionalProperties": true
     }
    }
   }
  },
  "pushCases": {
   "type": "array",
   "description": "Server-push cases (spec §2.3/§2.4). Run only when the certificate is produced for the case's transport: `--sse` (requests over HTTP, events over SSE) or `--ws`.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "level",
     "transport",
     "trigger",
     "expectEvents"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "level": {
      "enum": [
       1,
       2,
       3
      ]
     },
     "transport": {
      "enum": [
       "sse",
       "ws"
      ]
     },
     "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "method",
       "params"
      ],
      "properties": {
       "method": {
        "type": "string",
        "pattern": "^oumv/"
       },
       "params": {
        "type": "object"
       }
      }
     },
     "expectEvents": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "event"
       ],
       "properties": {
        "event": {
         "type": "string"
        },
        "data": {
         "type": "object",
         "description": "Keys that must match the event payload (params for WS notifications)."
        }
       }
      }
     },
     "replay": {
      "type": "object",
      "description": "SSE only: reconnect with Last-Event-ID captured before the trigger and expect the same events again.",
      "additionalProperties": false,
      "properties": {
       "expectEvents": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "event"
         ],
         "properties": {
          "event": {
           "type": "string"
          },
          "data": {
           "type": "object"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "capabilityCases": {
   "type": "array",
   "description": "Cases that run only when the runtime's handshake advertises `requiresCapability`. A runtime that does not advertise the capability is not penalised; it simply does not get the case in its report.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "level",
     "requiresCapability",
     "method",
     "params"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "level": {
      "enum": [
       1,
       2,
       3
      ]
     },
     "requiresCapability": {
      "type": "string",
      "description": "dotted capability path, e.g. verify.sandboxRollback"
     },
     "method": {
      "type": "string",
      "pattern": "^oumv/"
     },
     "params": {
      "type": "object"
     },
     "cleanup": {
      "type": "array",
      "description": "Paths removed before the case runs (a create-mode case must not inherit a previous run's file).",
      "items": {
       "type": "string"
      }
     },
     "followUp": {
      "type": "object",
      "description": "One extra call whose expectations the case also asserts (e.g. an atomicity probe).",
      "required": [
       "method",
       "params"
      ],
      "properties": {
       "method": {
        "type": "string",
        "pattern": "^oumv/"
       },
       "params": {
        "type": "object"
       },
       "expectResultFields": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "expectValues": {
        "type": "object"
       },
       "expectError": {
        "type": "object",
        "required": [
         "code"
        ],
        "properties": {
         "code": {
          "type": "integer"
         },
         "data": {
          "type": "object",
          "additionalProperties": true
         }
        }
       }
      }
     },
     "expectResultFields": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "expectValues": {
      "type": "object"
     },
     "expectError": {
      "type": "object",
      "required": [
       "code"
      ],
      "properties": {
       "code": {
        "type": "integer"
       },
       "data": {
        "type": "object",
        "description": "Exact key/value pairs the error payload must carry (e.g. editIndex).",
        "additionalProperties": true
       }
      }
     }
    }
   }
  },
  "sessionCases": {
   "type": "array",
   "description": "Session-lifecycle cases (wire 1.5.0): issue a handshake with sessionTtlSeconds, wait the granted lifetime, then assert the expired id is rejected.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "level",
     "ttlSeconds",
     "method",
     "params"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "level": {
      "enum": [
       1,
       2,
       3
      ]
     },
     "requiresCapability": {
      "type": "string",
      "description": "dotted capability path, e.g. sessions.ttlSeconds"
     },
     "ttlSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
     },
     "method": {
      "type": "string",
      "pattern": "^oumv/"
     },
     "params": {
      "type": "object"
     },
     "expectError": {
      "type": "object",
      "required": [
       "code"
      ],
      "properties": {
       "code": {
        "type": "integer"
       },
       "data": {
        "type": "object",
        "additionalProperties": true
       }
      }
     }
    }
   }
  }
 }
}
