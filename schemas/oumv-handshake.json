{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/tokensafe-dev/oumv/schemas/oumv-handshake.json",
 "title": "oumv/handshake",
 "x-oumv-spec-version": "1.6.0",
 "$defs": {
  "Request": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "protocolVersion"
   ],
   "properties": {
    "protocolVersion": {
     "type": "string"
    },
    "clientInfo": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "version"
     ],
     "properties": {
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     }
    },
    "supportedTransports": {
     "type": "array",
     "items": {
      "enum": [
       "http",
       "sse",
       "ws",
       "stdio",
       "memory"
      ]
     }
    },
    "requestedCapabilities": {
     "type": "object"
    },
    "sessionTtlSeconds": {
     "type": "integer",
     "minimum": 1,
     "maximum": 86400,
     "description": "Requested session lifetime (wire 1.5.0). Runtimes clamp to 1..86400 and answer the granted value as `ttlSeconds`; a runtime without `sessions.ttlSeconds` ignores it and serves its default."
    }
   }
  },
  "CapabilitySet": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "readOnly": {
     "type": "boolean",
     "description": "read-only deployment: the mutating methods are not registered at all (\u00a78.5, revision v1.11). Authoritative for clients \u2014 they MUST NOT perform the edit through their own tools."
    },
    "transports": {
     "type": "array",
     "description": "bindings this runtime actually mounted (spec \u00a72.3/\u00a72.4 advertise what exists)",
     "items": {
      "enum": [
       "http",
       "sse",
       "ws",
       "stdio",
       "memory",
       "batch"
      ]
     }
    },
    "observe": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "levels",
      "formats"
     ],
     "properties": {
      "levels": {
       "type": "array",
       "items": {
        "enum": [
         "L0",
         "L1",
         "L2",
         "L3",
         "L4"
        ]
       }
      },
      "formats": {
       "type": "array",
       "items": {
        "enum": [
         "json",
         "yaml"
        ]
       }
      }
     }
    },
    "understand": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "causality": {
       "type": "boolean"
      },
      "signalsGraph": {
       "type": "boolean"
      },
      "impactAnalysis": {
       "type": "boolean"
      },
      "typeGraph": {
       "type": "boolean"
      }
     }
    },
    "mutate": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "occ": {
       "type": "boolean"
      },
      "syntaxGuard": {
       "type": "boolean"
      },
      "ephemeralDispatch": {
       "type": "boolean"
      },
      "multiFile": {
       "type": "boolean",
       "description": "atomic multi-file applyEdit (wire 1.5.0)"
      },
      "preview": {
       "type": "boolean",
       "description": "implements oumv/previewEdit with the full \u00a74.4 guard order (wire 1.6.0)"
      }
     }
    },
    "sessions": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "ttlSeconds": {
       "type": "boolean",
       "description": "honours a client-requested handshake `sessionTtlSeconds` (wire 1.5.0)"
      },
      "cancel": {
       "type": "boolean",
       "description": "accepts oumv/cancel for in-flight requests (wire 1.6.0)"
      },
      "idempotency": {
       "type": "boolean",
       "description": "applyEdit/previewEdit honour params.idempotencyKey with first-result-wins replay (\u00a73, wire 1.6.0)"
      }
     }
    },
    "verify": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "multiMetric": {
       "type": "boolean"
      },
      "surfaceDiff": {
       "type": "boolean"
      },
      "sandboxRollback": {
       "type": "boolean"
      },
      "build": {
       "type": "boolean",
       "description": "implements oumv/build \u2014 run the configured build/test command and return structured diagnostics (wire 1.6.0)"
      }
     }
    },
    "index": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "symbols": {
       "type": "boolean",
       "description": "implements oumv/index repo-wide symbol search (\u00a714.1, wire 1.6.0)"
      }
     }
    },
    "observeQuery": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "readOnly": {
       "type": "boolean",
       "description": "implements oumv/query runtime-enforced read-only data access (\u00a714.2, wire 1.6.0)"
      }
     }
    },
    "events": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "diagnostic": {
       "type": "boolean",
       "description": "publishes diagnostic events on the push transports (\u00a72.6, wire 1.6.0)"
      }
     }
    }
   }
  },
  "Response": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "protocolVersion",
    "profile",
    "runtimeInfo",
    "capabilities",
    "sessionId"
   ],
   "properties": {
    "protocolVersion": {
     "type": "string"
    },
    "profile": {
     "enum": [
      "frontend",
      "backend"
     ]
    },
    "sessionId": {
     "type": "string",
     "minLength": 1
    },
    "ttlSeconds": {
     "type": "integer",
     "minimum": 1,
     "maximum": 86400,
     "description": "granted session lifetime; echoes the clamped `sessionTtlSeconds` or the runtime default"
    },
    "runtimeInfo": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "version"
     ],
     "properties": {
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      },
      "framework": {
       "type": "string"
      }
     }
    },
    "capabilities": {
     "$ref": "#/$defs/CapabilitySet"
    }
   }
  }
 },
 "anyOf": [
  {
   "$ref": "#/$defs/Request"
  },
  {
   "$ref": "#/$defs/Response"
  }
 ]
}