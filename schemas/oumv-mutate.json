{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/tokensafe-dev/oumv/schemas/oumv-mutate.json",
 "title": "oumv/getSource + oumv/applyEdit",
 "x-oumv-spec-version": "1.6.0",
 "$defs": {
  "GetSourceRequest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "symbol": {
     "type": "string"
    },
    "startLine": {
     "type": "integer",
     "minimum": 1,
     "description": "1-based first line of the returned window (inclusive). OCC still uses the whole file."
    },
    "endLine": {
     "type": "integer",
     "minimum": 1,
     "description": "1-based last line of the returned window (inclusive); clamped to the file length."
    },
    "ifVersion": {
     "type": "string",
     "pattern": "^sha256:[a-f0-9]{64}$",
     "description": "Return unchanged:true with no source when the file still has this version."
    }
   }
  },
  "GetSourceResponse": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "version"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "symbol": {
     "type": "string"
    },
    "source": {
     "type": "string"
    },
    "unchanged": {
     "type": "boolean",
     "description": "true when ifVersion matched: the file has not changed, so no bytes are resent"
    },
    "version": {
     "type": "string",
     "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "startLine": {
     "type": "integer",
     "minimum": 1
    },
    "endLine": {
     "type": "integer",
     "minimum": 1
    }
   },
   "allOf": [
    {
     "if": {
      "required": [
       "unchanged"
      ],
      "properties": {
       "unchanged": {
        "const": true
       }
      }
     },
     "then": {
      "not": {
       "required": [
        "source"
       ]
      }
     },
     "else": {
      "required": [
       "source"
      ]
     }
    }
   ]
  },
  "ApplyEditRequest": {
   "oneOf": [
    {
     "$ref": "#/$defs/ApplyEditReplaceRequest"
    },
    {
     "$ref": "#/$defs/ApplyEditCreateRequest"
    },
    {
     "$ref": "#/$defs/ApplyEditSymbolRequest"
    },
    {
     "$ref": "#/$defs/ApplyEditDeleteRequest"
    },
    {
     "$ref": "#/$defs/ApplyEditRenameRequest"
    },
    {
     "$ref": "#/$defs/ApplyEditPatchRequest"
    },
    {
     "$ref": "#/$defs/ApplyEditBatchRequest"
    }
   ]
  },
  "ApplyEditBatchRequest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "edits"
   ],
   "properties": {
    "edits": {
     "type": "array",
     "minItems": 1,
     "maxItems": 16,
     "description": "Multi-file atomic mutation (wire 1.5.0): every item is validated and syntax-checked before the first byte is written; a write failure restores the files already written and answers -32603 with data.rolledBack=true.",
     "items": {
      "$ref": "#/$defs/ApplyEditBatchItem"
     }
    }
   }
  },
  "ApplyEditBatchItem": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "mode": {
     "enum": [
      "replace",
      "create",
      "patch"
     ],
     "description": "Defaults to replace. Modes symbol/delete/rename are single-file operations and answer -32006 inside a batch."
    },
    "expectedVersion": {
     "type": "string",
     "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "replacement": {
     "type": "string"
    },
    "hunks": {
     "type": "array",
     "minItems": 1,
     "maxItems": 32,
     "items": {
      "$ref": "#/$defs/ApplyEditHunk"
     }
    }
   }
  },
  "ApplyEditBatchResponse": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "edits"
   ],
   "properties": {
    "status": {
     "enum": [
      "APPLIED"
     ]
    },
    "edits": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "path",
       "newVersion"
      ],
      "properties": {
       "path": {
        "type": "string"
       },
       "newVersion": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
       },
       "created": {
        "type": "boolean",
        "description": "true when the item ran mode=create"
       },
       "hunksApplied": {
        "type": "integer",
        "minimum": 1,
        "description": "number of hunks applied by a patch item"
       }
      }
     }
    }
   }
  },
  "ApplyEditHunk": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "target",
    "replacement"
   ],
   "properties": {
    "target": {
     "type": "string",
     "minLength": 1,
     "description": "Exact snippet, matched literally (not a regex)."
    },
    "replacement": {
     "type": "string"
    },
    "startLine": {
     "type": "integer",
     "minimum": 1,
     "description": "Optional 1-based inclusive lower bound for the search."
    },
    "endLine": {
     "type": "integer",
     "minimum": 1,
     "description": "Optional 1-based inclusive upper bound for the search; clamped to EOF."
    },
    "replaceAll": {
     "type": "boolean",
     "description": "Replace every occurrence instead of requiring exactly one."
    }
   }
  },
  "ApplyEditResponse": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "path"
   ],
   "properties": {
    "status": {
     "enum": [
      "APPLIED",
      "CURRENT"
     ]
    },
    "path": {
     "type": "string"
    },
    "symbol": {
     "type": "string"
    },
    "newVersion": {
     "type": "string",
     "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "syntaxCheck": {
     "type": "object",
     "required": [
      "status"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "enum": [
        "passed",
        "skipped",
        "failed"
       ]
      },
      "tool": {
       "type": "string"
      },
      "error": {
       "type": "string"
      }
     }
    },
    "backupPath": {
     "type": "string"
    },
    "rollbackHint": {
     "type": "string"
    },
    "created": {
     "type": "boolean",
     "description": "true when mode=create created the file"
    },
    "newPath": {
     "type": "string"
    },
    "deleted": {
     "type": "boolean",
     "description": "true when mode=delete removed the file"
    },
    "hunksApplied": {
     "type": "integer",
     "minimum": 1,
     "description": "number of hunks applied by mode=patch"
    }
   }
  },
  "ApplyEditReplaceRequest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "replacement",
    "expectedVersion"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "symbol": {
     "type": "string"
    },
    "replacement": {
     "type": "string"
    },
    "expectedVersion": {
     "type": "string",
     "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mode": {
     "enum": [
      "replace"
     ]
    }
   }
  },
  "ApplyEditCreateRequest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "replacement",
    "mode"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "replacement": {
     "type": "string"
    },
    "mode": {
     "const": "create"
    }
   }
  },
  "ApplyEditSymbolRequest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "symbol",
    "replacement",
    "expectedVersion",
    "mode"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "symbol": {
     "type": "string"
    },
    "replacement": {
     "type": "string"
    },
    "expectedVersion": {
     "type": "string",
     "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mode": {
     "const": "symbol"
    }
   }
  },
  "ApplyEditDeleteRequest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "expectedVersion",
    "mode"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "expectedVersion": {
     "type": "string",
     "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mode": {
     "const": "delete"
    }
   }
  },
  "ApplyEditRenameRequest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "renameTo",
    "expectedVersion",
    "mode"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "renameTo": {
     "type": "string"
    },
    "expectedVersion": {
     "type": "string",
     "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mode": {
     "const": "rename"
    }
   }
  },
  "ApplyEditPatchRequest": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "hunks",
    "expectedVersion",
    "mode"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "mode": {
     "const": "patch"
    },
    "expectedVersion": {
     "type": "string",
     "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "hunks": {
     "type": "array",
     "minItems": 1,
     "maxItems": 32,
     "description": "Applied in order to the evolving text; the first failure aborts the whole request with no bytes written.",
     "items": {
      "$ref": "#/$defs/ApplyEditHunk"
     }
    }
   }
  }
 },
 "anyOf": [
  {
   "$ref": "#/$defs/GetSourceRequest"
  },
  {
   "$ref": "#/$defs/GetSourceResponse"
  },
  {
   "$ref": "#/$defs/ApplyEditRequest"
  },
  {
   "$ref": "#/$defs/ApplyEditResponse"
  },
  {
   "$ref": "#/$defs/ApplyEditBatchResponse"
  }
 ]
}
