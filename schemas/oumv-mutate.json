{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tokensafe-dev/oumv/schemas/oumv-mutate.json",
  "title": "oumv/getSource + oumv/applyEdit",
  "x-oumv-spec-version": "1.1.0",
  "$defs": {
    "GetSourceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "GetSourceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ApplyEditRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "replacement",
        "expectedVersion"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "expectedVersion": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "ApplyEditResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "newVersion"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPLIED",
            "CURRENT"
          ]
        },
        "path": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "newVersion": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "syntaxCheck": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "skipped",
                "failed"
              ]
            },
            "tool": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        },
        "backupPath": {
          "type": "string"
        },
        "rollbackHint": {
          "type": "string"
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/GetSourceRequest"
    },
    {
      "$ref": "#/$defs/GetSourceResponse"
    },
    {
      "$ref": "#/$defs/ApplyEditRequest"
    },
    {
      "$ref": "#/$defs/ApplyEditResponse"
    }
  ]
}
