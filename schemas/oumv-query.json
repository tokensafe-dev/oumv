{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://oumv.org/schemas/oumv-query.json",
 "title": "oumv/query",
 "x-oumv-spec-version": "1.6.0",
 "description": "Runtime-enforced read-only data access (spec §14.2, optional extension; capability observeQuery.readOnly).",
 "$defs": {
  "Request": {
   "type": "object",
   "required": ["sql"],
   "properties": {
    "sessionId": { "type": "string" },
    "requestId": { "type": "string" },
    "timeoutMs": { "type": "integer", "exclusiveMinimum": 0 },
    "sql": { "type": "string", "minLength": 1 },
    "params": { "type": "array" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }
   }
  },
  "Response": {
   "type": "object",
   "required": ["columns", "rows", "rowCount", "truncated"],
   "properties": {
    "columns": { "type": "array", "items": { "type": "string" } },
    "rows": {
     "type": "array",
     "description": "Rows capped by limit; values JSON-native (null/number/string/boolean).",
     "items": { "type": "array" }
    },
    "rowCount": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" }
   }
  }
 },
 "anyOf": [
  { "$ref": "#/$defs/Request" },
  { "$ref": "#/$defs/Response" }
 ]
}
