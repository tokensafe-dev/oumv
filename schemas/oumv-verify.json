{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/tokensafe-dev/oumv/schemas/oumv-verify.json",
 "title": "oumv/verify",
 "x-oumv-spec-version": "1.6.0",
 "$defs": {
  "Request": {
   "type": "object",
   "additionalProperties": false,
   "required": [],
   "properties": {
    "target": {
     "type": "string"
    },
    "method": {
     "type": "string"
    },
    "action": {
     "type": "string"
    },
    "payload": {},
    "headers": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "steps": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Step"
     }
    },
    "sandbox": {
     "type": "object",
     "description": "opt-in transactional sandbox; mode=rollback runs the whole verify in one transaction and forces a rollback",
     "additionalProperties": false,
     "required": [
      "mode"
     ],
     "properties": {
      "mode": {
       "enum": [
        "rollback"
       ]
      }
     }
    }
   },
   "anyOf": [
    {
     "required": [
      "target"
     ]
    },
    {
     "required": [
      "steps"
     ]
    }
   ]
  },
  "Timings": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "t_action_ms",
    "t_schema_ms",
    "t_propagation_ms",
    "t_dom_ms",
    "t_total_ms"
   ],
   "properties": {
    "t_action_ms": {
     "type": "number",
     "minimum": 0
    },
    "t_schema_ms": {
     "type": "number",
     "minimum": 0
    },
    "t_propagation_ms": {
     "type": "number",
     "minimum": 0
    },
    "t_dom_ms": {
     "type": "number",
     "minimum": 0
    },
    "t_total_ms": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "Scope": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "checked",
    "notExecuted",
    "notSupported"
   ],
   "properties": {
    "checked": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "notExecuted": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "notSupported": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "SurfaceDiff": {
   "type": "object",
   "required": [
    "op",
    "target"
   ],
   "properties": {
    "op": {
     "enum": [
      "attr",
      "text",
      "visibility"
     ]
    },
    "target": {
     "type": "string"
    },
    "attr": {
     "type": "string"
    },
    "before": {},
    "after": {}
   }
  },
  "Response": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "diff",
    "timings",
    "durationMs",
    "scope"
   ],
   "properties": {
    "status": {
     "enum": [
      "passed",
      "failed"
     ]
    },
    "target": {
     "type": "string"
    },
    "statusCode": {
     "type": "integer"
    },
    "diff": {
     "type": "object"
    },
    "surfaceDiff": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/SurfaceDiff"
     }
    },
    "timings": {
     "$ref": "#/$defs/Timings"
    },
    "durationMs": {
     "type": "number",
     "minimum": 0
    },
    "scope": {
     "$ref": "#/$defs/Scope"
    },
    "rolledBack": {
     "type": "boolean"
    },
    "rollbackStatus": {
     "enum": [
      "verified",
      "unverified",
      "not_applicable"
     ]
    },
    "dbDiff": {
     "type": "object",
     "description": "sandbox evidence: rollback flag and the number of statements executed (never SQL text or parameters)",
     "additionalProperties": false,
     "required": [
      "rollback"
     ],
     "properties": {
      "rollback": {
       "type": "boolean"
      },
      "queries": {
       "type": "integer",
       "minimum": 0
      },
      "driver": {
       "type": "string"
      }
     }
    },
    "evidence": {
     "type": "object",
     "required": [
      "provenance",
      "sourceAdapter",
      "confidence"
     ],
     "additionalProperties": false,
     "properties": {
      "provenance": {
       "enum": [
        "runtime",
        "static",
        "contract",
        "inferred",
        "external"
       ]
      },
      "sourceAdapter": {
       "type": "string"
      },
      "confidence": {
       "enum": [
        "confirmed",
        "probable",
        "unknown"
       ]
      }
     }
    },
    "error": {
     "type": "string"
    },
    "steps": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/StepResult"
     }
    }
   }
  },
  "Step": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "target"
   ],
   "properties": {
    "target": {
     "type": "string"
    },
    "action": {
     "type": "string"
    },
    "payload": {},
    "headers": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  },
  "StepResult": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "target",
    "statusCode",
    "status"
   ],
   "properties": {
    "target": {
     "type": "string"
    },
    "statusCode": {
     "type": "integer"
    },
    "status": {
     "enum": [
      "passed",
      "failed"
     ]
    },
    "responseBody": {}
   }
  }
 },
 "anyOf": [
  {
   "$ref": "#/$defs/Request"
  },
  {
   "$ref": "#/$defs/Response"
  }
 ]
}
